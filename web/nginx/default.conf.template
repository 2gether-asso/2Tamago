# Rendered at startup by the nginx image (envsubst on ${API_UPSTREAM}). Plain HTTP:
# a reverse proxy in front terminates HTTPS.

# Keep the protocol seen by the outer proxy, if there is one.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolved at request time, so the container starts even when the API is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Hashed build assets never change.
    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: unknown routes get the fallback page, which the router handles.
    location / {
        try_files $uri $uri/ /404.html;
    }
}
