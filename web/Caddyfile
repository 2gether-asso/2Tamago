# SITE_ADDRESS: a domain name (automatic HTTPS) or ":80" behind another proxy.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv
		# Hashed build assets never change.
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /200.html
		file_server
	}
}
