# Copy to .env for local development.
PORT=3000

# Database. Without Docker, PGlite (embedded PostgreSQL) stores data in a folder:
#   pglite://.data/pglite   persistent, local file
#   memory://               in-memory, lost on restart (tests)
#   postgres://user:pass@host:5432/db   real PostgreSQL (production)
# With `make db-up`, the devcontainer reaches the local PostgreSQL at:
#   postgres://tamago:tamago@db:5432/tamago
DATABASE_URL=pglite://.data/pglite

# Secret used to sign session tokens. Required in production (32+ chars).
AUTH_SECRET=change-me-in-production-please-32chars
# Sessions: the access token is renewed quietly; a session ends after this long without a
# renewal, and after the hard limit. On another network than the sign-in's it renews for a few hours only.
# AUTH_ACCESS_TTL_MINUTES=30
# AUTH_REFRESH_IDLE_DAYS=7
# AUTH_SESSION_MAX_DAYS=30
# AUTH_ROAMING_HOURS=6
# Lets anyone sign in with a name, without Discord. Never enable in production.
AUTH_DEV_LOGIN=true

# Public URL of the web app (redirect after Discord sign-in).
WEB_ORIGIN=http://localhost:4321

# Discord OAuth2 (optional in development). Sign-in is limited to the members of DISCORD_GUILD_ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:4321/api/auth/discord/callback
# Invitation to the server, offered on the sign-in page to people who are not members yet.
DISCORD_INVITE_URL=
# Channel webhook for game announcements (new players, hatchings, evolutions, first meetings).
DISCORD_WEBHOOK_URL=
# Comma separated Discord user ids with admin rights.
ADMIN_DISCORD_IDS=

# Web Push notifications (hunger, sickness, tantrum, walk over): generate the keys with
# `make vapid-keys`. Off without both keys. VAPID_SUBJECT: a mailto: or https URL for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Game tuning. GAME_TIME_SCALE=60 makes a game day last 24 real minutes.
GAME_TIME_SCALE=1
GAME_DEPARTURE=true
GAME_TIMEZONE=Europe/Paris

# Error reporting (optional): a Sentry or GlitchTip DSN.
SENTRY_DSN=
# DSN of a separate (browser) project for web errors. Public: it is sent to the web app.
SENTRY_WEB_DSN=
