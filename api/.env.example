# Copy to .env for local development.
PORT=3000

# Database. Without Docker, PGlite (embedded PostgreSQL) stores data in a folder:
#   pglite://.data/pglite   persistent, local file
#   memory://               in-memory, lost on restart (tests)
#   postgres://user:pass@host:5432/db   real PostgreSQL (production)
DATABASE_URL=pglite://.data/pglite

# Secret used to sign session tokens. Required in production (32+ chars).
AUTH_SECRET=change-me-in-production-please-32chars
# Lets anyone sign in with a name, without Discord. Never enable in production.
AUTH_DEV_LOGIN=true
COOKIE_SECURE=false

# Public URL of the web app (redirect after Discord sign-in).
WEB_ORIGIN=http://localhost:4321

# Discord OAuth2 (optional in development). Sign-in is limited to the members of DISCORD_GUILD_ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:4321/api/auth/discord/callback
# Comma separated Discord user ids with admin rights.
ADMIN_DISCORD_IDS=

# Game tuning. GAME_TIME_SCALE=60 makes a game day last 24 real minutes.
GAME_TIME_SCALE=1
GAME_DEPARTURE=true
GAME_TIMEZONE=Europe/Paris
