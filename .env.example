# Settings of the Docker Compose stacks (docker-compose*.yml). Copy to .env.
# Development without Docker uses api/.env instead.

# --- Local stack (docker-compose.yml) -------------------------------------
WEB_PORT=8080
# API_PORT=3000
# GAME_TIME_SCALE=60

# --- Production / staging (docker-compose.prod.yml) -----------------------
# REGISTRY=ghcr.io/2gether-asso
# TAG=latest
# WEB_ORIGIN=https://tamago.example.org   # where the web app is served (GitHub Pages)
# API_ORIGIN=https://api.example.org      # public address of the API (Discord redirect)
# API_PORT=3000                           # the reverse proxy forwards API_ORIGIN to API_PORT
# API_BIND=0.0.0.0                        # 127.0.0.1 if the proxy runs on the same host
# WEB_PORT=8080 / WEB_BIND=0.0.0.0        # optional web image: `--profile web`
# POSTGRES_PASSWORD=
# AUTH_SECRET=            # openssl rand -base64 48
# AUTH_ACCESS_TTL_MINUTES=30   # access token, renewed quietly by the web app
# AUTH_REFRESH_IDLE_DAYS=7     # a session ends after this long without a renewal
# AUTH_SESSION_MAX_DAYS=30     # hard limit of a session
# AUTH_ROAMING_HOURS=6         # how long a session may renew from another network than its sign-in's
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=
# DISCORD_INVITE_URL=     # invitation link shown on the sign-in page, optional
# DISCORD_WEBHOOK_URL=    # channel webhook for game announcements, optional
# ADMIN_DISCORD_IDS=
# GAME_TIME_SCALE=1
# GAME_DEPARTURE=true
# GAME_TIMEZONE=Europe/Paris
# SENTRY_DSN=             # Sentry or GlitchTip, optional: API errors and the feedback form
# SENTRY_WEB_DSN=         # DSN of a separate browser project, optional: web errors
