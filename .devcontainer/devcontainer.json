{
  "name": "2tamago",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workdir",
  "postCreateCommand": "git config --global --add safe.directory /workdir && pnpm install",
  "shutdownAction": "stopCompose",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "2Tamago (web + /api)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "esbenp.prettier-vscode"]
    }
  }
}
